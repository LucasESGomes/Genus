# Modelo genérico de ambiente da api do coletor (padrão: dev).
# Copie para .env.dev (ou .env) e preencha. Nunca versione o arquivo real.
# Segredos marcados TROQUE_... são placeholders: gere valores reais antes de subir.

# --- Ambiente ---
# Ambiente de execução: dev | homolog | prod. Deve bater com o nome do arquivo.
APP_ENV=dev
PORT=3001
# Nível de log do Pino (debug | info | warn | error).
LOG_LEVEL=debug

# --- Banco "arp" (fiscal, só cresce) ---
# Papel arp_collector: só INSERT em entradas/registros/evidencias, via rep-core.
ARP_DATABASE_URL=postgres://arp_collector:TROQUE_SENHA_ARP_COLLECTOR@localhost:5432/arp
# Papel arp_owner: usado somente pelas migrations (db/arp/migrations), nunca em runtime.
ARP_MIGRATION_DATABASE_URL=postgres://arp_owner:TROQUE_SENHA_ARP_OWNER@localhost:5432/arp

# --- Motor facial (services/face-engine) ---
# URL interna da engine. Em dev, a porta 8001 só existe com o perfil "dev" do compose.
ENGINE_URL=http://localhost:8001
# Chave que a api envia no header da engine. Deve ser igual a ENGINE_API_KEY do face-engine.
ENGINE_API_KEY=TROQUE_ENGINE_API_KEY
# Chave de cifragem de envelope (64 hex). Deve ser idêntica à MASTER_KEY da engine.
MASTER_KEY=TROQUE_MASTER_KEY_64_HEX
# Tempo máximo (ms) esperando a engine antes de responder erro ao aparelho.
ENGINE_TIMEOUT_MS=800
# Reconhecimentos simultâneos enviados à engine (1 vCPU: manter baixo).
ENGINE_MAX_CONCURRENCY=4

# --- Autenticação dos aparelhos ---
# Lista separada por vírgula para permitir rotação (chave nova entra antes da antiga sair).
# Em prod, cada chave precisa ter 32 caracteres ou mais.
COLLECTOR_SERVICE_KEYS=TROQUE_CHAVE_SERVICO_ATUAL,TROQUE_CHAVE_SERVICO_NOVA

# --- Entrada de imagem ---
# Tamanho máximo (bytes) da imagem recebida do aparelho. 1048576 = 1 MB.
MAX_IMAGE_BYTES=1048576

# --- Candidatos falsos (desenvolvimento e homologação) ---
# Quando true, a api gera candidatos fictícios para testar sem a galeria real.
FAKE_CANDIDATES_ENABLED=true
# Quantidade de candidatos fictícios gerados.
FAKE_CANDIDATES_COUNT=20
# Caminho de uma galeria de desenvolvimento (relativo a apps/collector-api).
DEV_GALLERY_PATH=../../dev-data/gallery.json

# --- Diagnóstico ---
# Quando true, a resposta inclui tempos internos (útil para medir; falso fora de dev).
EXPOSE_TIMINGS=true

# --- Tentativas de fraude ---
# Pasta das imagens de liveness_failed (dado biométrico, cifrado com chave derivada da MASTER_KEY).
# Relativa a apps/collector-api ou absoluta. Nada é apagado automaticamente (retenção [A CONFIRMAR]).
FRAUD_FRAMES_DIR=data/fraudes

# --- Contexto fixo provisório do aparelho ---
# Tenant, estabelecimento e aparelho fixos. Provisório: será trocado por certificado/token do aparelho.
DEV_TENANT_ID=1
DEV_ESTABLISHMENT_ID=1
DEV_DEVICE_ID=1

# Modelo de ambiente da api do portal (dev, fora do Docker: pnpm dev:api).
# `pnpm setup:rh` cria o .env.dev a partir deste arquivo, alinhado ao .env da raiz.
# Dentro do Docker estas variáveis vêm do docker-compose.yml da raiz.

APP_ENV=dev
PORT=3002
LOG_LEVEL=debug

# --- Banco "app" (RH, instância postgres-rh) ---
# Papel rh_api: runtime, DML no schema rh.
RH_DATABASE_URL=postgres://rh_api:TROQUE_SENHA_RH_API@localhost:5433/app
# Papel rh_owner: somente as migrations (pnpm db:migrate:rh), nunca em runtime.
RH_MIGRATION_DATABASE_URL=postgres://rh_owner:TROQUE_SENHA_RH_OWNER@localhost:5433/app
DATABASE_POOL_MAX=10

# Origens do portal (Next.js) separadas por vírgula. Vazio = sem CORS.
CORS_ORIGINS=http://localhost:3000

# --- Leitura do banco arp (parte do ponto), só para pnpm rh:check-arp ---
# Papel arp_reader (somente leitura). Porta = POSTGRES_PORT do infra/.env.
ARP_READER_DATABASE_URL=postgres://arp_reader:TROQUE_SENHA_ARP_READER@localhost:5432/arp

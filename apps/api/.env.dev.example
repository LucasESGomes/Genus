# Modelo de ambiente da api do portal (dev, fora do Docker: pnpm dev:api).
# `pnpm setup:dev` cria o .env.dev a partir deste arquivo, alinhado ao .env da raiz.
# Dentro do Docker estas variáveis vêm de apps/api/service.compose.yml.

APP_ENV=dev
PORT=3002
LOG_LEVEL=debug

# --- Banco "app" (RH, mesma instância Postgres do arp) ---
# Papel rh_api: runtime, DML no schema rh.
RH_DATABASE_URL=postgres://rh_api:TROQUE_SENHA_RH_API@localhost:5432/app
# Papel rh_owner: somente as migrations (pnpm db:migrate:rh), nunca em runtime.
RH_MIGRATION_DATABASE_URL=postgres://rh_owner:TROQUE_SENHA_RH_OWNER@localhost:5432/app
DATABASE_POOL_MAX=10

# Origens do portal (Next.js) separadas por vírgula. Vazio = sem CORS.
CORS_ORIGINS=http://localhost:3000

# --- Login (Better Auth) ---
# Segredo: assina cookies e cifra o segredo do 2FA e a chave privada do JWT. `pnpm setup:dev` gera.
BETTER_AUTH_SECRET=TROQUE_SEGREDO_BETTER_AUTH
# URL da api (só a origem): emissor e audiência do JWT.
AUTH_BASE_URL=http://localhost:3002

# --- Leitura do banco arp (parte do ponto): batidas para a apuração e pnpm rh:check-arp ---
# Papel arp_reader (somente leitura). Porta = POSTGRES_PORT do .env da raiz.
ARP_READER_DATABASE_URL=postgres://arp_reader:TROQUE_SENHA_ARP_READER@localhost:5432/arp

# --- PIN do colaborador (totem) ---
# 64 hex; igual ao PIN_PEPPER do .env da raiz (pnpm setup:dev copia).
PIN_PEPPER=TROQUE_PIN_PEPPER
PIN_PEPPER_VERSION=1

# --- Engine facial (cadastro no totem: POST /embeddings/register) ---
# Sem as duas, o cadastro facial responde 503 MOTOR_FACIAL_INDISPONIVEL; o resto da api funciona.
ENGINE_URL=http://localhost:8001
ENGINE_API_KEY=TROQUE_CHAVE_API_ENGINE

# --- Anexos (atestados) em disco local; o S3 entra depois atrás da mesma interface ---
ATTACHMENTS_DIR=./data/anexos
MAX_ATTACHMENT_BYTES=10485760

# --- Perfil gestor no portal (desligado por padrão: ajustes vão direto ao RH) ---
PORTAL_GESTOR_ENABLED=false

# --- Análise de atestado com IA (G6). Opcional: vazio = mock determinística com aviso IA_SIMULADA ---
# Chave AES-256 (64 hex) do dado de saúde da análise; igual à do .env da raiz (pnpm setup:dev copia).
CERTIFICATE_DATA_KEY=TROQUE_CHAVE_DADOS_ATESTADO
# Provedor: anthropic | openai_compativel | mock. Comparação: pnpm --filter @genus/api rh:compare-ai
# CERTIFICATE_AI_PROVIDER=anthropic
# CERTIFICATE_AI_MODEL=claude-haiku-5-5
# CERTIFICATE_AI_ANTHROPIC_API_KEY=
# CERTIFICATE_AI_OPENAI_BASE_URL=http://localhost:11434/v1
# CERTIFICATE_AI_OPENAI_API_KEY=
# CERTIFICATE_AI_TIMEOUT_MS=20000

# Limiares padrão da engine (só para mostrar o valor efetivo de um totem sem calibração). Opcionais.
# ENGINE_DEFAULT_RECOGNITION_THRESHOLD=1.1
# ENGINE_DEFAULT_LIVENESS_THRESHOLD=0.85

# --- Painel do super_admin (opcional) ---
# super_admin criado/atualizado na partida: e-mail + nome + (hash OU senha). `pnpm setup:dev` preenche com senha gerada.
# Em prod, prefira o hash: `pnpm rh:hash-password` (lê a senha do stdin ou de NEW_PASSWORD).
# SUPER_ADMIN_EMAIL=superadmin@genus.local
# SUPER_ADMIN_NAME="Operação Genus"
# SUPER_ADMIN_PASSWORD_HASH=
# SUPER_ADMIN_PASSWORD=
# KEK (64 hex) da chave da empresa nova (POST /portal/super-admin/tenants). Igual à do coletor e da engine. Sem ela: 503.
# MASTER_KEY=
# Saúde do sistema: Valkey (fila) e api do coletor. Sem elas, o check fica "não configurado".
# VALKEY_URL=redis://localhost:6379
# VALKEY_PASSWORD=
# COLLECTOR_API_URL=http://localhost:3001

# Modelo de ambiente do rep-core (worker da fila punches), dev.
# Em dev o processo lê ../collector-api/.env.dev (script start); copie estas chaves para lá ou use este arquivo.
# Nunca versione o arquivo real. TROQUE_... são placeholders.

APP_ENV=dev
LOG_LEVEL=debug

# Papel arp_core: escreve registros, evidencias e outbox; atualiza entradas (status, tentativas, processado_em).
ARP_CORE_DATABASE_URL=postgres://arp_core:TROQUE_SENHA_ARP_CORE@localhost:5432/arp

# Valkey: URL SEM senha. A senha vai separada e é obrigatória fora de dev/test.
VALKEY_URL=redis://localhost:6379
VALKEY_PASSWORD=

# Jobs processados em paralelo (1 a 32). O pool de conexões usa este valor + 4.
WORKER_CONCURRENCY=4
# Tentativas por job (backoff exponencial de 1 s). Esgotadas: entrada vira 'falhou'.
QUEUE_ATTEMPTS=5
# Prazo (ms) para publicar em post-punch depois do COMMIT. Falha só gera aviso; o resgate cobre.
QUEUE_PUBLISH_TIMEOUT_MS=250

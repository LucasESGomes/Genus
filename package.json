{
  "name": "genus",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev": "pnpm --filter @genus/collector-api dev",
    "db:migrate:arp": "pnpm --filter @genus/db-arp migrate",
    "dev:enroll-fake": "pnpm --filter @genus/collector-api dev:enroll-fake",
    "postman:test": "pnpm --filter @genus/collector-api postman:test",
    "bench:punch": "pnpm --filter @genus/collector-api bench:punch",
    "setup:dev": "node scripts/setup-dev.mjs",
    "dev:up": "node scripts/dev-up.mjs",
    "dev:punch": "pnpm --filter @genus/collector-api dev:punch",
    "postman:export": "node scripts/postman-export.mjs",
    "arp:verify-chain": "pnpm --filter @genus/rep-core verify-chain"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  }
}

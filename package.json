{
  "name": "genus",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev": "node scripts/dev-all.mjs",
    "db:migrate:arp": "pnpm --filter @genus/db-arp migrate",
    "dev:enroll-fake": "pnpm --filter @genus/collector-api dev:enroll-fake",
    "postman:test": "pnpm --filter @genus/collector-api postman:test",
    "bench:punch": "pnpm --filter @genus/collector-api bench:punch",
    "bench:nsr": "pnpm --filter @genus/e2e bench:nsr",
    "setup:dev": "node scripts/setup-dev.mjs",
    "dev:up": "node scripts/dev-up.mjs",
    "dev:punch": "pnpm --filter @genus/collector-api dev:punch",
    "fraud:frames": "pnpm --filter @genus/collector-api fraud:frames",
    "dev:rep-core": "pnpm --filter @genus/rep-core start",
    "dev:jobs": "pnpm --filter @genus/jobs start",
    "queue:inspect": "node scripts/queue-inspect.mjs",
    "postman:export": "node scripts/postman-export.mjs",
    "arp:verify-chain": "pnpm --filter @genus/rep-core verify-chain",
    "dev:api": "pnpm --filter @genus/api dev",
    "db:migrate:rh": "pnpm --filter @genus/api db:migrate",
    "db:generate:rh": "pnpm --filter @genus/api db:generate",
    "rh:check-arp": "pnpm --filter @genus/api check-arp",
    "rh:create-user": "pnpm --filter @genus/api rh:create-user",
    "rh:hash-password": "pnpm --filter @genus/api rh:hash-password",
    "rh:seed-dev": "pnpm --filter @genus/api rh:seed-dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  }
}

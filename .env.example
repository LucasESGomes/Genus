# Variáveis do docker-compose.yml da RAIZ (parte de RH: postgres-rh, api-migrate, api).
# As do Postgres do arp, Valkey e engine continuam em infra/.env (pnpm setup:dev).
# `pnpm setup:rh` cria o .env a partir deste arquivo, com senhas geradas. Nunca versione o .env.

# --- Postgres do RH (instância própria, banco `app`, schema `rh`) ---
# Superusuário do contêiner: só administração. As aplicações usam rh_owner e rh_api.
RH_POSTGRES_USER=genus_rh_admin
RH_POSTGRES_PASSWORD=TROQUE_SENHA_RH_POSTGRES
# Dono do banco app: só as migrations (serviço api-migrate).
RH_OWNER_PASSWORD=TROQUE_SENHA_RH_OWNER
# Runtime da api: DML no schema rh. Use só [0-9a-f] (a senha entra na URL de conexão).
RH_API_PASSWORD=TROQUE_SENHA_RH_API
# Porta no host (127.0.0.1). 5432 é do Postgres do arp.
RH_POSTGRES_PORT=5433

# --- API do portal ---
API_PORT=3002

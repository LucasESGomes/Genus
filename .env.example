# Variáveis de TODOS os docker-compose.yml do repositório (um único .env, na raiz).
# `pnpm setup:dev` cria o .env a partir deste arquivo, com senhas geradas, e alinha os .env.dev dos apps
# (para rodar os processos fora do Docker com `pnpm dev`). Nunca versione o .env.
# Valores TROQUE_... são placeholders: o setup troca todos. Use só [0-9a-f] nas senhas (entram em URLs de conexão).

# --- PostgreSQL: UMA instância, dois bancos lógicos (arp fiscal e app operacional) ---
# Superusuário do contêiner: só administração e o serviço db-roles. As aplicações usam os papéis abaixo.
POSTGRES_USER=TROQUE_USUARIO_ADMIN
POSTGRES_PASSWORD=TROQUE_SENHA_SUPERUSUARIO
# Porta publicada em 127.0.0.1 no host.
POSTGRES_PORT=5432

# Banco arp (fiscal)
# Dono do banco: só as migrations (serviço arp-migrate).
ARP_OWNER_PASSWORD=TROQUE_SENHA_ARP_OWNER
# api do coletor em runtime: só INSERT e SELECT em entradas.
ARP_COLLECTOR_PASSWORD=TROQUE_SENHA_ARP_COLLECTOR
# rep-core em runtime: única escrita em registros, evidencias e outbox.
ARP_CORE_PASSWORD=TROQUE_SENHA_ARP_CORE
# Somente leitura (resgate, verificação da cadeia de NSR, conferência do RH).
ARP_READER_PASSWORD=TROQUE_SENHA_ARP_READER

# Banco app (operacional, schema rh)
# Dono do banco: só as migrations do Drizzle (serviço rh-migrate).
RH_OWNER_PASSWORD=TROQUE_SENHA_RH_OWNER
# api do portal em runtime: DML no schema rh, sem DDL.
RH_API_PASSWORD=TROQUE_SENHA_RH_API

# --- Valkey (fila das batidas: BullMQ) ---
# Senha obrigatória: o servidor exige AUTH.
VALKEY_PASSWORD=TROQUE_SENHA_VALKEY
VALKEY_PORT=6379

# --- Motor facial ---
# Chave de cifragem de envelope: 64 caracteres hexadecimais (32 bytes). Igual na api do coletor e na engine.
MASTER_KEY=TROQUE_POR_64_HEX
# Chave de API da engine (header enviado pela api do coletor).
ENGINE_API_KEY=TROQUE_CHAVE_API_ENGINE
ENGINE_PORT=8001

# --- API do coletor ---
# Chaves de serviço dos aparelhos, separadas por vírgula (rotação: a nova entra antes de a antiga sair).
COLLECTOR_SERVICE_KEYS=TROQUE_CHAVE_SERVICO
COLLECTOR_PORT=3001

# --- API do portal de RH ---
API_PORT=3002
# Origens do portal (Next.js), separadas por vírgula.
CORS_ORIGINS=http://localhost:3000
# Segredo do login (Better Auth), 64 hex. Trocar derruba as sessões e invalida o 2FA cifrado.
BETTER_AUTH_SECRET=TROQUE_SEGREDO_BETTER_AUTH
# Pepper do PIN do colaborador (64 hex). `pnpm setup:dev` gera. Trocar invalida os PINs já cadastrados.
PIN_PEPPER=TROQUE_PIN_PEPPER
# URL pública da api do RH (só a origem): emissor e audiência do JWT. Padrão http://localhost:<API_PORT>.
# AUTH_BASE_URL=http://localhost:3002
# Chave do dado de saúde da análise de atestado (CID, texto, evidências), 64 hex. `pnpm setup:dev` gera.
# Trocar torna ilegíveis as análises já gravadas.
CERTIFICATE_DATA_KEY=TROQUE_CHAVE_DADOS_ATESTADO

# --- Análise de atestado com IA (opcional; vazio = mock determinística, com aviso IA_SIMULADA) ---
# Provedor: anthropic | openai_compativel | mock. Modelo: ex. claude-haiku-5-5 (anthropic) ou llama3.1:8b (local).
# CERTIFICATE_AI_PROVIDER=anthropic
# CERTIFICATE_AI_MODEL=claude-haiku-5-5
# CERTIFICATE_AI_ANTHROPIC_API_KEY=
# Servidor OpenAI-compatível, até o /v1 (modelo local mantém o atestado na infraestrutura):
# CERTIFICATE_AI_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# CERTIFICATE_AI_OPENAI_API_KEY=
# CERTIFICATE_AI_TIMEOUT_MS=20000

# --- Opcionais (valores padrão entre parênteses) ---
# APP_ENV=dev                 LOG_LEVEL=info
# POSTGRES_MEM_LIMIT=1g       ENGINE_MEM_LIMIT=2g        ENGINE_CPUS=1.0
# WORKER_CONCURRENCY=4        QUEUE_ATTEMPTS=5
# RESCUE_INTERVAL_MS=20000    RESCUE_MIN_AGE_MS=30000

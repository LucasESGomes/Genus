# Modelo de variáveis da infraestrutura local (docker compose).
# Copie para infra/.env e troque TODOS os valores TROQUE_... antes de subir.
# Nunca versione infra/.env.

# --- PostgreSQL (superusuário do contêiner) ---
# Gere a senha com: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_USER=TROQUE_USUARIO_ADMIN
POSTGRES_PASSWORD=TROQUE_SENHA_SUPERUSUARIO
# Porta publicada em 127.0.0.1 no host.
POSTGRES_PORT=5432

# --- Papéis do banco arp (criados na primeira subida pelo script de init) ---
# Dono do banco arp: só usado pelas migrations.
ARP_OWNER_PASSWORD=TROQUE_SENHA_ARP_OWNER
# Papel da api do coletor em runtime: só INSERT e SELECT em entradas.
ARP_COLLECTOR_PASSWORD=TROQUE_SENHA_ARP_COLLECTOR
# Papel do rep-core em runtime: única escrita em registros, evidencias e outbox.
ARP_CORE_PASSWORD=TROQUE_SENHA_ARP_CORE
# Papel somente leitura (resgate e verificação da cadeia de NSR).
ARP_READER_PASSWORD=TROQUE_SENHA_ARP_READER

# --- Valkey (fila das batidas: BullMQ) ---
# Senha obrigatória: o servidor exige AUTH. Gere como as outras senhas.
VALKEY_PASSWORD=TROQUE_SENHA_VALKEY
# Porta no host (127.0.0.1). Só existe com o perfil "dev"; sem ele, o Valkey fica só na rede do Compose.
VALKEY_PORT=6379

# --- Motor facial ---
# Chave de cifragem de envelope: 64 caracteres hexadecimais (32 bytes).
# Gere com: python -c "import os; print(os.urandom(32).hex())"
# Placeholder abaixo é inválido de propósito; troque pelo valor gerado.
MASTER_KEY=TROQUE_POR_64_HEX_GERADOS_COM_python_-c_import_os_print_os.urandom_32_.hex
# Chave de API da engine (header enviado pela api do coletor).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENGINE_API_KEY=TROQUE_CHAVE_API_ENGINE

# --- Portas publicadas no host (127.0.0.1) ---
# Porta da engine: usada só com o perfil "dev".
ENGINE_PORT=8001

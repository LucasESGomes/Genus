.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="1542" y="440" width="56" height="56" as="geometry"/></mxCell><mxCell id="c56" value="backups do Postgres&lt;br&gt;WAL contínuo · fotos (7 d)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1490.0" y="500" width="160" height="46" as="geometry"/></mxCell><mxCell id="c57" value="HTTPS + mTLS · IP fixo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="c3" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c59" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="c7" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="450"/><mxPoint x="380" y="182"/></Array></mxGeometry></mxCell><mxCell id="c60" value="PDFs · AFD · backup contínuo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.95;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="c16" target="c50"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1046" y="732"/><mxPoint x="1570" y="732"/></Array></mxGeometry></mxCell><mxCell id="c61" value="VM 2 · reconhecimento · 1 vCPU · 4 GB" style="html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=0;collapsible=0;pointerEvents=0;verticalAlign=top;align=left;spacingLeft=30;spacingTop=4;fillColor=none;rounded=1;arcSize=3;dashed=1;strokeColor=#2563EB;fontColor=#2563EB;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1100" y="110" width="320" height="260" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b&gt;face-engine&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Python · motor Visage&lt;br&gt;POST /identificar · /verificar · /cadastrar&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=13;fontColor=#1F2937;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1120" y="155" width="280" height="95" as="geometry"/></mxCell><mxCell id="c63" value="① quem é?" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.9;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="c18" target="c62"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="591.0" y="210"/><mxPoint x="1092" y="210"/><mxPoint x="1092" y="202"/></Array></mxGeometry></mxCell><mxCell id="c64" value="&lt;b&gt;pg_receivewal&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;recebe cada commit do banco antes de confirmar&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=13;fontColor=#1F2937;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1120" y="265" width="280" height="64" as="geometry"/></mxCell><mxCell id="c65" value="WAL síncrono" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#232F3E;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.97;entryX=1;entryY=0.5;" edge="1" parent="1" source="c16" target="c64"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="692"/><mxPoint x="1435" y="692"/><mxPoint x="1435" y="297"/></Array></mxGeometry></mxCell><mxCell id="c66" value="&lt;b&gt;Quanto aguenta&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="1650" height="26" as="geometry"/></mxCell><mxCell id="c67" value="• &lt;b&gt;VM 2 (reconhecimento) é o limite:&lt;/b&gt; ~2,5–3,5 rostos/s numa vCPU compartilhada → pico de ~1.000–1.400 funcionários. Confortável até ~800–1.000. Acima disso a válvula do PIN segura o pico sem travar ninguém.&lt;br&gt;• &lt;b&gt;VM 1 (core) sobra:&lt;/b&gt; caminho síncrono ~5–10 ms de CPU por batida (~100 batidas/s) · PDF assinado ~20–30/s · RAM usada ~2,5–3 GB de 4. Só vira gargalo perto de ~4–5 mil funcionários.&lt;br&gt;• &lt;b&gt;Custo:&lt;/b&gt; 2 VPS de entrada + S3 ≈ R$ 90–120/mês. Estimativa: medir a Visage nessa vCPU é o primeiro teste." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="808" width="1650" height="100" as="geometry"/></mxCell><mxCell id="c68" value="&lt;b&gt;Fluxo de uma batida&lt;/b&gt; · ① api-coletor pergunta ao face-engine “quem é?” (síncrono, ~0,3–1 s) → ② &lt;b&gt;COMMIT&lt;/b&gt; da batida na tabela &lt;b&gt;entrada&lt;/b&gt; com status &lt;i&gt;pendente&lt;/i&gt; (a partir daqui ela existe em disco) → ③ &lt;b&gt;publica&lt;/b&gt; na &lt;b&gt;fila batidas&lt;/b&gt; (fora da transação) e responde ao aparelho “Maria, recebido” + QR → ④ rep-core &lt;b&gt;consome&lt;/b&gt; → ⑤ numa transação só: NSR + hash em &lt;b&gt;registros&lt;/b&gt;, entrada = &lt;i&gt;processado&lt;/i&gt;, eventos “gerar PDF / calcular jornada / QR oficial” no &lt;b&gt;outbox&lt;/b&gt; (&lt;i&gt;pendente&lt;/i&gt;) → ⑥ &lt;b&gt;publica&lt;/b&gt; na &lt;b&gt;fila pós-batida&lt;/b&gt; → ⑦ jobs &lt;b&gt;consome&lt;/b&gt;, faz o trabalho e marca o evento como &lt;i&gt;processado&lt;/i&gt;.&lt;br&gt;&lt;b&gt;Garantia:&lt;/b&gt; a tabela é a fonte da verdade; a fila só transporta. Quem marca &lt;i&gt;processado&lt;/i&gt; é o consumidor, ao terminar. O &lt;b&gt;resgate&lt;/b&gt; roda sempre e republica o que está &lt;i&gt;pendente&lt;/i&gt; há mais de 30 s (queda entre o COMMIT e a publicação, ou mensagem perdida no Valkey). Duplicatas são inofensivas: jobId no BullMQ + unicidade no banco (aparelho + sequência, NSR + tarefa).&lt;br&gt;Se o face-engine demorar mais de ~1,5 s, o aparelho pede PIN + foto: a batida entra na hora e o rosto é conferido depois." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="910" width="1650" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Tier 2 - 3 VMs" id="Tier2-"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Tier 2 · 3 VMs · ~1.000 a ~2.500 funcionários" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1650" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Mesmo core; duas VMs de reconhecimento. A api-coletor reparte entre elas e, se uma cair, usa a outra. A segunda pode ligar só no horário de pico." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1650" height="24" as="geometry"/></mxCell><mxCell id="c3" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3D;strokeColor=none;dashed=0;html=1;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.mobile_client;" vertex="1" parent="1"><mxGeometry x="80" y="230" width="41" height="78" as="geometry"/></mxCell><mxCell id="c4" value="Aparelhos coletores&lt;br&gt;tablet · celular · PC" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="15.5" y="312" width="170" height="46" as="geometry"/></mxCell><mxCell id="c5" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3D;strokeColor=none;dashed=0;html=1;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.users;" vertex="1" parent="1"><mxGeometry x="70" y="420" width="60" height="60" as="geometry"/></mxCell><mxCell id="c6" value="RH · trabalhador · auditor&lt;br&gt;+ página pública do QR" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="15.0" y="484" width="170" height="46" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Cloudflare&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;DNS · proteção dos portais&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=13;fontColor=#1F2937;fillColor=#FFF4E5;strokeColor=#F38020;" vertex="1" parent="1"><mxGeometry x="200" y="410" width="150" height="80" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Monitor externo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;avisa se a VM sumir&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=13;fontColor=#1F2937;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="200" y="540" width="150" height="64" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;NTP Observatório Nac.&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;hora oficial (chrony)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=13;fontColor=#1F2937;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="200" y="625" width="150" height="64" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Legenda&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="78" width="330" height="22" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;API (HTTP)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=13;fontColor=#1F2937;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="160" height="30" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Worker (sem tela)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=13;fontColor=#1F2937;fillColor=#D5E8D4;strokeColor=#3F8F3F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="210" y="100" width="160" height="30" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;API interna Python&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=13;fontColor=#1F2937;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="136" width="160" height="30" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Tabela no Postgres&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=13;fontColor=#1F2937;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="210" y="136" width="160" height="30" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Fila de mensagens (BullMQ no Valkey)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=13;fontColor=#1F2937;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="172" width="330" height="30" as="geometry"/></mxCell><mxCell id="c16" value="VM 1 · core · 1 vCPU · 4 GB (2 vCPU · 8 GB acima de ~3 mil)" style="html=1;whiteSpace=wrap;fontSize=13;fontStyle=1;container=0;collapsible=0;pointerEvents=0;verticalAlign=top;align=left;spacingLeft=30;spacingTop=4;fillColor=none;ro
# ============================================================================
# MASTER_KEY — Envelope Encryption (DEVE SER IDÊNTICA AO BACKEND)
# ============================================================================
# 256-bit (32 bytes) hex string para descriptografar DEKs de tenants
# Gerado com: python -c "import os; print(os.urandom(32).hex())"
# NUNCA compartilhar, NUNCA fazer log, NUNCA hardcoded
MASTER_KEY=TROQUE_POR_64_HEX_GERADOS_COM_python_-c_import_os_print_os.urandom_32_.hex

# ============================================================================
# AUTENTICAÇÃO
# ============================================================================
# API Key para validar requisições do Node.js
ENGINE_API_KEY=your-engine-api-key-change-in-production

# ============================================================================
# RECONHECIMENTO FACIAL
# ============================================================================
# Threshold de distância euclidiana para reconhecimento positivo
RECOGNITION_THRESHOLD=1.10

# Threshold de score de liveness (0.0 a 1.0)
LIVENESS_THRESHOLD=0.85

# ============================================================================
# MODELOS ONNX — Anti-Spoofing
# ============================================================================
# Caminho para MiniFASNetV1 (crop scale 2.7×)
LIVENESS_MODEL_V1_PATH=./models/2.7_80x80_MiniFASNetV1.onnx

# Caminho para MiniFASNetV2 (crop scale 4.0×)
LIVENESS_MODEL_V2_PATH=./models/4_0_80x80_MiniFASNetV2.onnx

# ============================================================================
# CACHE
# ============================================================================
# Time-to-live para cache de DEK descriptografada por tenant (horas)
DEK_CACHE_TTL_HOURS=1

# ============================================================================
# SERVIDOR
# ============================================================================
# Porta da engine
PORT=8001
